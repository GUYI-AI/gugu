# gugu: the NSIS installer/uninstaller must not close processes of a sibling install.
# Stock 26.15.3 matches running processes with $_.Path.StartsWith('$INSTDIR') and no separator, so the
# production installer (C:\Program Files\gugu) also closes Beta (C:\Program Files\gugu-beta\...) and
# acceptance builds (gugu-acceptance-*) — on install, on update (the old version's uninstaller runs the
# same check), and on uninstall.
#
# Source: electron-builder PR #10024, merge commit 8e95ad0e00c866c8389ae295ac802ebd9954d2ca. Only its
# prefix half is taken, line for line: trim trailing backslashes from $INSTDIR, then match '<dir>\'.
# Not taken: the registry InstallLocation matching (#10022) and the single-quote escaping — other bugs,
# not hit here.
#
# Remove the upstream process-matching hunks when upgrading to a release containing #10024.
# The installSection hooks below are Gugu-specific: retain or replace them during an upgrade;
# build-resources/nsis/zip-transaction.nsh supplies the same-volume ZIP installation transaction.
#
# Also from upstream (electron-builder master, allowOnlyOneInstallerInstance.nsh): every PowerShell call runs with
# -NoProfile -NonInteractive. Without it each call loads the user's profile; on a machine whose profile runs
# `conda init` that is 6–10 s per call, and an update makes six of them (installer + old uninstaller).
# #2734 adds two optional payload transaction hooks, retaining upstream UI, registration,
# shortcut management, and uninstaller generation/signing. Without them ZIP installation
# still uninstalls the old app before extraction and cannot roll back a disk/full or lock error.
# The assisted-directory hook preserves registered custom installation locations;
# the stock name-appending behavior would make a GUI upgrade target its own child.
# In-app updates (--updated) need no clicks: the assisted installer keeps the existing installation's scope instead
# of asking (multiUserUi.nsh), shows only its progress page, and with --force-run relaunches the app and closes
# instead of waiting on the finish page (installSection.nsh). Stock only does this for silent (/S) runs, which
# show no progress at all. Manual installs keep the full wizard.
diff --git a/templates/nsis/assistedInstaller.nsh b/templates/nsis/assistedInstaller.nsh
--- a/templates/nsis/assistedInstaller.nsh
+++ b/templates/nsis/assistedInstaller.nsh
@@ -32,8 +32,12 @@
     # sanitize the MUI_PAGE_DIRECTORY result to make sure it has a application name sub-folder
     Function instFilesPre
+      !ifmacrodef customSanitizeInstallDirectory
+        !insertmacro customSanitizeInstallDirectory
+      !else
       ${StrContains} $0 "${APP_FILENAME}" $INSTDIR
       ${If} $0 == ""
         StrCpy $INSTDIR "$INSTDIR\${APP_FILENAME}"
       ${endIf}
+      !endif
     FunctionEnd
   !endif
diff --git a/templates/nsis/include/allowOnlyOneInstallerInstance.nsh b/templates/nsis/include/allowOnlyOneInstallerInstance.nsh
index a5cb3fe536a9fe95a95ac796f92a27f62d9762cc..f4c9ae6d7774cf9de873d77c86210cbff81545dc 100644
--- a/templates/nsis/include/allowOnlyOneInstallerInstance.nsh
+++ b/templates/nsis/include/allowOnlyOneInstallerInstance.nsh
@@ -29,11 +29,36 @@
   launch:
 !macroend
 
+# strips trailing backslashes from the path in register _VAR (_TEMP is scratch), so that the
+# single separator the caller appends cannot become a double backslash that never matches
+!macro TRIM_TRAILING_BACKSLASHES _VAR _TEMP
+  ${Do}
+    StrCpy ${_TEMP} ${_VAR} 1 -1
+    ${if} ${_TEMP} != "\"
+      ${Break}
+    ${endIf}
+    StrCpy ${_VAR} ${_VAR} -1
+  ${Loop}
+!macroend
+
 !macro CHECK_APP_RUNNING
   Var /GLOBAL CmdPath
   Var /GLOBAL PowerShellPath
+  Var /GLOBAL processPathFilter
   StrCpy $CmdPath "$SYSDIR\cmd.exe"
   StrCpy $PowerShellPath "$SYSDIR\WindowsPowerShell\v1.0\powershell.exe"
+  Push $R8
+  Push $R9
+  # PowerShell filter matching processes running from the installation directory
+  # (trailing backslash so that a sibling directory with the same prefix is not matched).
+  # $R8 = $INSTDIR with any trailing backslashes stripped ($INSTDIR can carry one, e.g. from
+  # /D=C:\path\ or a registry-restored install location, and the appended separator below
+  # would then become a never-matching double backslash)
+  StrCpy $R8 $INSTDIR
+  !insertmacro TRIM_TRAILING_BACKSLASHES $R8 $R9
+  StrCpy $processPathFilter "$$_.Path.StartsWith('$R8\', 'CurrentCultureIgnoreCase')"
+  Pop $R9
+  Pop $R8
   !ifmacrodef customCheckAppRunning
     !insertmacro customCheckAppRunning
   !else
@@ -45,12 +70,12 @@
 !macro IS_POWERSHELL_AVAILABLE
   Var /GLOBAL IsPowerShellAvailable ; 0 = available, 1 = not available
   # Try running PowerShell with a simple command to check if it's available
-  nsExec::Exec `"$PowerShellPath" -C "if (Get-Command Get-CimInstance -ErrorAction SilentlyContinue) { exit 0 } else { exit 1 }"`
+  nsExec::Exec `"$PowerShellPath" -NoProfile -NonInteractive -C "if (Get-Command Get-CimInstance -ErrorAction SilentlyContinue) { exit 0 } else { exit 1 }"`
   Pop $0  # Return code (0 = success, other = error)
 
   ${if} $0 == 0
     # PowerShell is available, check if it's not blocked by policies
-    nsExec::Exec `"$PowerShellPath" -C "if ((Get-ExecutionPolicy -Scope Process) -eq 'Restricted') { exit 1 } else { exit 0 }"`
+    nsExec::Exec `"$PowerShellPath" -NoProfile -NonInteractive -C "if ((Get-ExecutionPolicy -Scope Process) -eq 'Restricted') { exit 1 } else { exit 0 }"`
     Pop $0
   ${endIf}
 
@@ -63,7 +88,7 @@
 
 !macro FIND_PROCESS _FILE _RETURN
   ${if} $IsPowerShellAvailable == 0
-    nsExec::Exec `"$PowerShellPath" -C "if ((Get-CimInstance -ClassName Win32_Process | ? {$$_.Path -and $$_.Path.StartsWith('$INSTDIR', 'CurrentCultureIgnoreCase')}).Count -gt 0) { exit 0 } else { exit 1 }"`
+    nsExec::Exec `"$PowerShellPath" -NoProfile -NonInteractive -C "if ((Get-CimInstance -ClassName Win32_Process | ? {$$_.Path -and ($processPathFilter)}).Count -gt 0) { exit 0 } else { exit 1 }"`
     Pop ${_RETURN}
   ${else}
     !ifdef INSTALL_MODE_PER_ALL_USERS
@@ -91,7 +116,7 @@
   ${endIf}
 
   ${if} $IsPowerShellAvailable == 0
-    nsExec::Exec `"$PowerShellPath" -C "Get-CimInstance -ClassName Win32_Process | ? {$$_.Path -and $$_.Path.StartsWith('$INSTDIR', 'CurrentCultureIgnoreCase')} | % { Stop-Process -Id $$_.ProcessId $0 }"`
+    nsExec::Exec `"$PowerShellPath" -NoProfile -NonInteractive -C "Get-CimInstance -ClassName Win32_Process | ? {$$_.Path -and ($processPathFilter)} | % { Stop-Process -Id $$_.ProcessId $0 }"`
   ${else}
     !ifdef INSTALL_MODE_PER_ALL_USERS
       nsExec::Exec `taskkill /IM "${_FILE}" /FI "PID ne $pid"`
