@@ -49,6 +49,11 @@ ${if} $isTryToKeepShortcuts == "true"
   ${endIf}
 ${endif}
 
+# Allow a package to prepare and atomically publish its payload before registration,
+# while retaining the stock uninstaller generation/signing and all UI/scope behavior.
+!ifmacrodef customInstallApplication
