+!else
 !insertmacro uninstallOldVersion SHELL_CONTEXT
 !insertmacro handleUninstallResult SHELL_CONTEXT
 
@@ -64,6 +69,8 @@ SetOutPath $INSTDIR
 !endif
 
 !insertmacro installApplicationFiles
+!endif
+
 !insertmacro registryAddInstallInfo
 !insertmacro addStartMenuLink $keepShortcuts
 !insertmacro addDesktopLink $keepShortcuts
@@ -82,6 +89,10 @@ ${endIf}
   !insertmacro customInstall
 !endif
 
+!ifmacrodef customInstallApplicationComplete
+  !insertmacro customInstallApplicationComplete
+!endif
+
 !macro doStartApp
   # otherwise app window will be in background
   HideWindow
@@ -102,9 +113,13 @@ ${endIf}
   !endif
   !insertmacro quitSuccess
 !else
-  # for assisted installer run only if silent, because assisted installer has run after finish option
+  # for assisted installer run only if silent, because assisted installer has run after finish option;
+  # an in-app update (--updated) shows only its progress page, so it also relaunches here and skips the finish page
   ${if} ${isForceRun}
-  ${andIf} ${Silent}
-    !insertmacro doStartApp
+    ${if} ${Silent}
+    ${orIf} ${isUpdated}
+      !insertmacro doStartApp
+      !insertmacro quitSuccess
+    ${endIf}
   ${endIf}
 !endif
