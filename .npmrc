# Keep slow dependency downloads bounded without excessive concurrency.
fetch-timeout=300000
network-concurrency=8

# Pinned installer archives use the same immutable origin as the build bundlers.
electron_mirror=https://download.gugu.nextmind.space/releases/vendor/electron/
electron_builder_binaries_mirror=https://download.gugu.nextmind.space/releases/vendor/electron-builder/
